{
	"rules": {
		"rooms": {
			"$code": {
				"public": {
					".read": true,
					".write": "auth != null"
				},
				"secrets": {
					".write": "auth != null && root.child('rooms/'+$code+'/public/hostId').val() === auth.uid",
					"$playerId": {
						".read": "auth != null && (auth.uid === $playerId || root.child('rooms/'+$code+'/public/hostId').val() === auth.uid || root.child('rooms/'+$code+'/public/phase').val() === 'result')"
					}
				}
			}
		}
	}
}
